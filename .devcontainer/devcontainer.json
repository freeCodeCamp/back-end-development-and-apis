{
  "name": "Back-End Development and APIs",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24",
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/back-end-development-and-apis",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "freeCodeCamp.freecodecamp-courses@3.0.0",
        "freeCodeCamp.freecodecamp-dark-vscode-theme"
      ]
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "npm ci && node tooling/adjust-url.js"
}
